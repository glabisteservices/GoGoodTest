<div class="padding-global padding-section-medium">
          <div class="container-large">
            <div class="article_wrapper">
              <div class="div-article-image"><img class="image-6" src="{{ article.image | image_url: width: 100%}}" alt="{{ article.image.alt }}" sizes="(max-width: 600px) 100vw, 600px" li-object:src="article.image | image_url: width: 100%" loading="lazy" li-object:alt="article.image.alt" srcset="{{ 'PHOTO-2024-07-26-23-07-05-2-600x600.jpg' | asset_url }} 500w, {{ 'PHOTO-2024-07-26-23-07-05-2-600x600.jpg' | asset_url }} 600w"></div>
              <h1 li-object="article.title">{{ article.title }}</h1>
              <div li-object="article.content" class="text-rich-text w-richtext">{{ article.content }}</div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Article Content",
    "class": "section_article",
    "presets": [
        {
            "name": "Article Content",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "article"
        ]
    }
} {% endschema %}